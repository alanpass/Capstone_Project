# 複製成 .env 後填入實際值（.env 已被 .gitignore 排除，絕對不要提交）

# Firebase 服務帳戶：擇一設定
# 部署（Render）時建議把整份 JSON 內容貼進環境變數 FIREBASE_CREDENTIALS_JSON
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-admin.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CWA_API_KEY=
CWA_VERIFY_SSL=true
DEFAULT_CITY=高雄市

THINGSPEAK_CHANNEL_ID=3013983
THINGSPEAK_READ_KEY=
SOIL_ADC_DRY=0
SOIL_ADC_WET=1993

# ESP32 取得門檻值時使用的金鑰（自行產生一組長隨機字串）
DEVICE_API_KEY=

# 允許呼叫 API 的前端網址（逗號分隔）
ALLOWED_ORIGINS=https://alanpass.github.io,https://plantai-cac82.web.app,http://localhost:5500
APP_TIMEZONE=Asia/Taipei
