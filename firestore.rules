rules_version = '2';

// 部署：Firebase Console → Firestore → 規則，貼上本檔內容後發布
// 或使用 CLI：firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isNumber(v) { return v is int || v is float; }

    // 使用者基本資料：只能讀寫自己的
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // 種植專案：只能存取自己的，並檢查欄位
      match /plants/{plantId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['plant_name', 'summary', 'start_date', 'total_days', 'created_at'])
          && request.resource.data.plant_name is string && request.resource.data.plant_name.size() <= 40
          && request.resource.data.start_date is string
          && request.resource.data.total_days is int
          && request.resource.data.total_days >= 1 && request.resource.data.total_days <= 365;

        // AI 照護指南快取
        match /guides/{guideId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ESP32 自動控制門檻值
    //  - 只有本人可以寫入，並檢查欄位
    //  - 允許以 uid 讀取「單一文件」（get），讓 ESP32 不必登入即可透過 REST API 取得；
    //    不允許 list，無法列舉其他使用者。門檻值只是溫濕度數字，不含個人資料。
    match /thresholds/{uid} {
      allow get: if true;
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tempMin', 'tempMax', 'humidMin', 'humidMax', 'soilMin', 'updatedAt'])
        && isNumber(request.resource.data.tempMin) && isNumber(request.resource.data.tempMax)
        && request.resource.data.tempMin < request.resource.data.tempMax;
    }

    // 其他集合（含舊版的 plants、planting_records）一律禁止從前端存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
