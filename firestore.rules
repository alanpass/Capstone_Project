rules_version = '2';

// 部署：Firebase Console → Firestore → 規則，貼上本檔內容後發布
// 或使用 CLI：firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isNumber(v) { return v is int || v is float; }

    // 使用者基本資料：只能讀寫自己的
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // 種植專案與 AI 指南快取：只能讀自己的，寫入一律經過後端（Admin SDK 不受規則限制）
      match /plants/{plantId} {
        allow read: if isOwner(uid);
        allow write: if false;
        match /guides/{guideId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // ESP32 門檻值：只能讀寫自己的，並檢查欄位型別
    match /thresholds/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tempMin', 'tempMax', 'humidMin', 'humidMax', 'soilMin', 'updatedAt'])
        && isNumber(request.resource.data.tempMin) && isNumber(request.resource.data.tempMax)
        && request.resource.data.tempMin < request.resource.data.tempMax;
    }

    // 其他集合（含舊版的 plants、planting_records）一律禁止從前端存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
